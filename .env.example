# =============================================================================
# Grammarin environment variables
# Copy this file to .env.local and fill in values from your Supabase project.
# Never commit .env.local — it is gitignored.
# =============================================================================

# Project URL from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key — safe to expose in the browser
# Dashboard → Project Settings → API → Project API keys → anon / publishable
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Service role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_ or commit it.
# Only needed if you use admin/server-side privileged operations.
# Dashboard → Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL used for OAuth redirects (Google sign-in)
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
